# ============================================
# Abekyo Editor - Environment variables
# ============================================
# Copy this file to .env.local (or .env) and fill in values.
#
#   cp .env.example .env.local
#
# Nothing here is required for local development — the app runs with
# no env vars set. These are all optional overrides.
# ============================================

# Public base URL used for canonical links, hreflang alternates, and
# server-side absolute URL resolution (inside /api/render).
# Default: http://localhost:3000
# Set this to your deployment URL in production, e.g. https://editor.example.com
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Repository URL used by the landing page GitHub CTAs and footer links.
# When unset, the GitHub buttons are hidden entirely (no dead placeholder link).
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/your-repo

# --- Render rate limiting (optional) ---
# Max simultaneous /api/render jobs across the process. Remotion is heavy
# (Chromium + ffmpeg); raise this only on beefy hardware.
# Default: 1
# RENDER_MAX_CONCURRENT=1

# Per-IP sliding window length in milliseconds.
# Default: 600000 (10 minutes)
# RENDER_RATE_LIMIT_WINDOW_MS=600000

# Max /api/render requests per IP within the window.
# Default: 10
# RENDER_RATE_LIMIT_MAX=10

# --- Render resource ceilings (optional) ---
# Bound what an unauthenticated caller can make the renderer do. Applied by
# both /api/render and /api/project/validate (same shared validator).

# Max clips per project.
# Default: 200
# RENDER_MAX_CLIPS=200

# Max duration of a single clip, in seconds.
# Default: 300
# RENDER_MAX_CLIP_DURATION_SECONDS=300

# Max total video duration, in seconds.
# Default: 1800 (30 minutes)
# RENDER_MAX_TOTAL_DURATION_SECONDS=1800

# Max subtitles per project.
# Default: 2000
# RENDER_MAX_SUBTITLES=2000

# --- Media origin policy (optional) ---
# Extra hosts the renderer may fetch media from, beyond its own origin.
# Comma-separated hostnames; everything else must be a same-origin
# /uploads/... path. Default: empty (same-origin only).
# RENDER_ALLOWED_MEDIA_HOSTS=cdn.example.com,img.example.com

# --- Client IP resolution (optional) ---
# Set to "true" ONLY when the app runs behind a reverse proxy you control, so
# rate limiting reads X-Forwarded-For. Leaving it unset is the safe default,
# but note the consequence: without a trusted proxy header every client is
# bucketed under the same "unknown" key, so one caller exhausting the limit
# locks out everyone. Set this whenever you deploy behind a proxy.
# TRUST_PROXY_HEADERS=false

# --- Upload retention (optional) ---
# Days after which uploaded media and rendered outputs under public/uploads
# are deleted by the background sweep. UNSET MEANS NOTHING IS EVER DELETED,
# so a public deployment will fill its disk. Set this in any deployment that
# accepts uploads from people other than you.
# UPLOAD_RETENTION_DAYS=7

# --- Puxin studio (Node 22+, one server process) ---
# PUXIN_DATA_DIR=/srv/ai-workspace/shared/puxin-video-studio
# PUXIN_RENDER_ORIGIN=http://127.0.0.1:3471
# PUXIN_PUBLIC_ORIGIN=https://studio.example.com
# PUXIN_RENDER_CONCURRENCY=1
# Keep the existing Basic authentication header secret. Set a separate random
# render media signing secret if Basic authentication is not configured.
# PUXIN_BASIC_AUTH_HEADER=
# PUXIN_RENDER_MEDIA_SECRET=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=
# VERTEX_TTS_LOCATION=global
# VERTEX_TTS_MODEL=gemini-3.1-flash-tts-preview
# PUXIN_DRIVE_OUTPUT_FOLDER_ID=11KCNFFXmZQG6CSITUNM_WfXA-nyOr0ah
# Personal My Drive output requires the owner's OAuth consent. Existing folder
# access needs drive scope (drive.file alone does not grant the supplied folder).
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# Only enable this when the chosen output folder belongs to a Shared Drive.
# PUXIN_DRIVE_OUTPUT_SHARED_DRIVE=false
